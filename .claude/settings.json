{
  "permissions": {
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin beta:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin HEAD:beta:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git config core.hooksPath:*)",
      "Bash(git remote set-url:*)",
      "Bash(git checkout main:*)",
      "Bash(git checkout beta:*)",
      "Bash(git merge:*)",
      "Bash(railway up --environment production:*)",
      "Bash(railway up --environment beta:*)",
      "Bash(railway environment link production:*)",
      "Bash(railway environment link beta:*)"
    ],
    "allow": [
      "Bash(git push origin emilia:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(npm run check:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(railway status:*)",
      "Bash(railway up --environment emilia:*)",
      "Bash(railway logs:*)"
    ]
  }
}
